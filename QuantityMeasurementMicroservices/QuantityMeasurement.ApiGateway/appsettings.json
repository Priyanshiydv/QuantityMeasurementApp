{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "QuantityMeasurementAPI",
    "Audience": "QuantityMeasurementAPI"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "qma-route": {
        "ClusterId": "qma-cluster",
        "Match": {
          "Path": "/api/v1/qma/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "qma-cluster": {
        "Destinations": {
          "qma-destination": {
            "Address": "http://localhost:5002/"
          }
        }
      }
    }
  }
}