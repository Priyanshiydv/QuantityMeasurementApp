<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true">

  <targets>
    <!-- Console target -->
    <target xsi:type="Console"
            name="consoleTarget"
            layout="${longdate} | ${level:uppercase=true} | ${logger:shortName=true} | ${message} ${exception:format=tostring}"/>

    <!-- File target -->
    <target xsi:type="File"
            name="fileTarget"
            fileName="${currentdir}/logs/app-${shortdate}.log"
            layout="${longdate} | ${level:uppercase=true} | ${logger:shortName=true} | ${message} ${exception:format=tostring}"/>

    <!-- Error file target -->
    <target xsi:type="File"
            name="errorTarget"
            fileName="${currentdir}/logs/errors-${shortdate}.log"
            layout="${longdate} | ${level:uppercase=true} | ${logger:shortName=true} | ${message} ${exception:format=tostring}"/>
  </targets>

  <rules>
    <!-- Skip Microsoft logs -->
    <logger name="Microsoft.*" maxlevel="Info" final="true"/>
    <logger name="System.*" maxlevel="Info" final="true"/>

    <!-- All logs to console and file -->
    <logger name="*" minlevel="Debug" writeTo="consoleTarget,fileTarget"/>

    <!-- Error logs to error file -->
    <logger name="*" minlevel="Error" writeTo="errorTarget"/>
  </rules>

</nlog>